# ================================================================
# RailGuard - Member 6: Maps, Satellite & Data Environment Config
# ================================================================

# Optional: Custom Satellite Tile Provider URL template
# Default fallback: Esri World Imagery (No API key needed)
# Example: https://api.mapbox.com/styles/v1/mapbox/satellite-v9/tiles/{z}/{x}/{y}?access_token={apiKey}
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Optional: Satellite Provider API Key (if using Mapbox, Stadia, or Planet Labs)
VITE_SATELLITE_API_KEY=your_satellite_api_key_here

# Optional: OpenWeatherMap API Key (for live atmospheric data over synthetic fallback)
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Backend API Base URL (leave empty to use local synthetic data)
# When Member 1 / 2 connects their FastAPI backend, set to http://localhost:8000
VITE_API_BASE_URL=
