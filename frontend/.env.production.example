# RailGuard Frontend Production Environment Configuration
# Set these in the Vercel Dashboard -> Settings -> Environment Variables

# The deployed Render backend service URL (NO trailing slash)
VITE_API_BASE_URL=https://railguard-backend.onrender.com

# Optional: Satellite tile provider (built-in Esri World Imagery fallback if omitted)
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Optional: OpenWeatherMap API Key (built-in synthetic weather data if omitted)
# VITE_WEATHER_API_KEY=
