# ================================================================
# RailGuard - Member 6: Maps, Satellite & Data Configuration
# ================================================================

# Satellite Tile Provider Configuration
# Leave blank to use built-in free Esri World Imagery tiles
SATELLITE_API_KEY=
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Weather API Configuration (Optional)
# Leave blank to use 32-section synthetic Indian Meteorological data
WEATHER_API_KEY=

# Backend API Configuration (Optional - for future FastAPI integration)
FASTAPI_BACKEND_URL=http://localhost:8000
